{
  "rules": {
    "site": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('level').val() < 2"
    },
    "users": {
      "$user_id": {
        ".read": true,
        ".write": "root.child('users').child(auth.uid).child('level').val() < 2",
        "connections": {
          ".write": "$user_id === auth.uid"
        }
      }
    }
  }
}
