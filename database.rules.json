{
  "rules": {
    "site": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('level').val() < 2"
    },
    "users": {
      "$user_id": {
        ".read": "$user_id === auth.uid || root.child('users').child(auth.uid).child('level').val() < 2",
        ".write": "($user_id === auth.uid && data.child('level').val() === newData.child('level').val()) || root.child('users').child(auth.uid).child('level').val() < 2"
      }
    }
  }
}
